# ShieldEye Example Environment

# Database Configuration
DB_HOST=postgres
DB_PORT=55432
DB_NAME=shieldeye
DB_USER=shieldeye
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
# Required by docker-compose for the postgres container itself (must match DB_PASSWORD)
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
# Required by docker-compose for the minio container root user (must match MINIO_ACCESS_KEY)
MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
# Required by docker-compose for the minio container itself (must match MINIO_SECRET_KEY)
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY

# API / Service Ports
API_PORT=3000
ANALYZER_PORT=3001
RENDERER_PORT=3002
DESKTOP_PORT=3003

# External Vulnerability Feeds
OSV_API_URL=https://api.osv.dev
NVD_API_URL=https://services.nvd.nist.gov/rest/json
NVD_API_KEY=

# Transport security (TLS to Postgres/MinIO).
# Local docker-compose containers (postgres:15, minio) serve plain connections,
# so this MUST be false for the dev stack. Set true in production with TLS-terminating services.
TLS_ENABLED=false

# Security (MUST be overridden in any real deployment)
JWT_SECRET=CHANGE_ME_JWT_SECRET
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_ENCRYPTION_KEY

# Logging
LOG_LEVEL=info
LOG_FILE=logs/shieldeye.log

# Optional single URL for tools that prefer it
DATABASE_URL=postgresql://shieldeye:CHANGE_ME_DB_PASSWORD@postgres:5432/shieldeye

# Experimental API endpoints (disabled by default)
# Set to 'true' to enable /api/monitoring, /api/blockchain, /api/quantum, /api/settings
ENABLE_EXPERIMENTAL_API=false

# Optional route and runtime feature flags
# Enable legacy minimal API router under /api/minimal
ENABLE_MINIMAL_ROUTES=false
# Control operational endpoints and instrumentation in API
ENABLE_METRICS=true
ENABLE_HEALTH_CHECKS=true
# Analyzer compatibility mode: consume legacy Redis list via BRPOP in parallel with Bull
ENABLE_LEGACY_ANALYSIS_CONSUMER=false
